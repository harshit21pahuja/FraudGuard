table dataset_summary
	lineageTag: a47a1f00-a195-55af-9d9a-ec0250418e89

	measure 'Total Transactions' = SUM(dataset_summary[total_records])
		formatString: #,##0
		lineageTag: 9231e9c5-85a2-5a68-8e92-7858137dab82

	measure 'Total Fraud Cases' = SUM(dataset_summary[fraud_records])
		formatString: #,##0
		lineageTag: 7ee0e042-36c1-5316-b5b7-7845e3a2651b

	measure 'Total Legitimate Transactions' = SUM(dataset_summary[legitimate_records])
		formatString: #,##0
		lineageTag: a2986379-8ff0-5ca0-95d8-07629fc7cb97

	measure 'Fraud Prevalence Pct' = DIVIDE(SUM(dataset_summary[fraud_records]), SUM(dataset_summary[total_records]), 0) * 100
		formatString: 0.0000
		lineageTag: e3b30f5b-3aa6-5a28-a516-9f7919ab876e

