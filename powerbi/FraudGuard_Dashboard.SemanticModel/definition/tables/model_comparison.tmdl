table model_comparison
	lineageTag: 7af7fc0a-c4ae-5063-8046-3078bab5bcc4

	measure 'Best F1 Score' = MAX(model_comparison[f1_score])
		formatString: 0.0000
		lineageTag: 34bb2ddb-b18c-5690-9ab1-98718996bdcb

	measure 'Best PR-AUC' = MAX(model_comparison[pr_auc])
		formatString: 0.0000
		lineageTag: f2b9df13-cf31-5727-8655-2f91164bc34a

	measure 'Lowest Log Loss' = MIN(model_comparison[log_loss])
		formatString: 0.00000
		lineageTag: ea07d33b-ca41-555e-b32e-f68dee2c2384

	measure 'Top Performing Model' = CONCATENATEX(TOPN(1, model_comparison, model_comparison[pr_auc], DESC), model_comparison[model_name], ", ")
		lineageTag: a67bec47-da48-5d60-92fa-99b327753591

