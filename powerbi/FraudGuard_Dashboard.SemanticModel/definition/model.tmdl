model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dataset_summary","model_comparison","threshold_analysis","hyperparameter_tuning","amount_distribution","missingness_profile","hourly_fraud_pattern","fraud_by_product","fraud_by_card"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table dataset_summary
ref table model_comparison
ref table threshold_analysis
ref table hyperparameter_tuning
ref table amount_distribution
ref table missingness_profile
ref table hourly_fraud_pattern
ref table fraud_by_product
ref table fraud_by_card

