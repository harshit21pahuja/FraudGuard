# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Temporary office and system lock files
~$*
*.tmp

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Datasets (Never commit raw or processed datasets to Git)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Sensitive credentials & API keys
kaggle.json
*.key
*.pem
*.token
credentials.json

# Model checkpoints and large binaries
models/*.model
*.parquet
*.orc
*.h5

# Output logs and large artifacts
outputs/logs/*.log
!outputs/logs/.gitkeep
catboost_info/
